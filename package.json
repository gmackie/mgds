{
  "name": "@mgds/workspace",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Model Game Development Standard reference workspace",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": "11.10.0"
  },
  "scripts": {
    "test": "node --test tests/**/*.test.mjs",
    "validate:smoke": "node scripts/validate-smoke.mjs",
    "license:check": "uvx --with 'reuse[charset-normalizer]' reuse lint",
    "check": "pnpm validate:smoke && pnpm license:check && pnpm test"
  },
  "devDependencies": {
    "ajv": "8.17.1"
  }
}
