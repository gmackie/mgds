{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mgds.dev/schemas/v0/campaign-evidence.schema.json",
  "title": "MGDS campaign evidence bundle",
  "type": "object",
  "required": [
    "schema",
    "runId",
    "slotId",
    "events",
    "artifacts",
    "privacy",
    "replayStatus"
  ],
  "properties": {
    "schema": {
      "const": "mgds.campaign-evidence/v1"
    },
    "runId": {
      "type": "string",
      "pattern": "^run_[A-Za-z0-9_-]{16,}$"
    },
    "slotId": {
      "type": "string",
      "minLength": 16,
      "maxLength": 512
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sequence",
          "previousHash",
          "event",
          "hash"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "previousHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "event": {
            "type": "object"
          },
          "hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "hash",
          "bytesBase64"
        ],
        "properties": {
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "hash": {
            "$ref": "#/$defs/hash"
          },
          "bytesBase64": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]*={0,2}$"
          }
        },
        "additionalProperties": false
      }
    },
    "privacy": {
      "type": "object",
      "required": [
        "classification",
        "redactionVersion"
      ],
      "properties": {
        "classification": {
          "const": "public-redacted"
        },
        "redactionVersion": {
          "const": "mgds.redaction/v1"
        }
      },
      "additionalProperties": false
    },
    "replayStatus": {
      "const": "verified"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
