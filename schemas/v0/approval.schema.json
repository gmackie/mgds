{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mgds.dev/schemas/v0/approval.schema.json",
  "title": "MGDS exact approval",
  "type": "object",
  "required": ["id", "requestHash", "projectScope", "riskCeiling", "approverRef", "expiresAt", "signature"],
  "properties": {
    "id": { "type": "string", "pattern": "^approval_[A-Za-z0-9_-]{16,}$" },
    "requestHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "projectScope": { "type": "string", "pattern": "^prj_[A-Za-z0-9_-]{16,}$" },
    "riskCeiling": { "type": "string", "enum": ["read", "bounded-write", "elevated", "irreversible"] },
    "approverRef": { "type": "string", "pattern": "^principal_[A-Za-z0-9_-]{16,}$" },
    "expiresAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
    "signature": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
