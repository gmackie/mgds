{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mgds.dev/schemas/v0/policy.schema.json",
  "title": "MGDS policy",
  "type": "object",
  "required": ["version", "defaultDecision", "grants"],
  "properties": {
    "version": { "const": 1 },
    "defaultDecision": { "const": "deny" },
    "grants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capabilityId", "projectScope", "riskCeiling", "expiresAt", "budget"],
        "properties": {
          "capabilityId": { "type": "string", "pattern": "^mgds\\.unity\\.[a-z0-9.-]+@[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "projectScope": { "type": "string", "pattern": "^prj_[A-Za-z0-9_-]{16,}$" },
          "riskCeiling": { "type": "string", "enum": ["read", "bounded-write", "elevated", "irreversible"] },
          "expiresAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
          "budget": { "$ref": "https://mgds.dev/schemas/v0/budget.schema.json" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
