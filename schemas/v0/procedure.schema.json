{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mgds.dev/schemas/v0/procedure.schema.json",
  "title": "MGDS procedure request",
  "type": "object",
  "required": ["id", "capabilityId", "idempotency", "inputs", "timeoutSeconds"],
  "properties": {
    "id": { "type": "string", "pattern": "^proc_[A-Za-z0-9_-]{16,}$" },
    "capabilityId": { "type": "string", "pattern": "^mgds\\.unity\\.[a-z0-9.-]+@[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "idempotency": { "type": "string", "enum": ["safe", "key-required", "never"] },
    "idempotencyKey": { "type": "string", "pattern": "^idem_[A-Za-z0-9_-]{16,}$" },
    "inputs": { "type": "object" },
    "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
    "requestedBudget": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "idempotency": { "const": "key-required" } }, "required": ["idempotency"] },
      "then": { "properties": { "idempotencyKey": true }, "required": ["idempotencyKey"] }
    }
  ],
  "additionalProperties": false
}
