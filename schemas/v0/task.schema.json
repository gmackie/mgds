{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mgds.dev/schemas/v0/task.schema.json",
  "title": "MGDS benchmark task",
  "type": "object",
  "required": ["id", "title", "description", "requiredCapabilities", "fixtureHash", "inputsHash", "evaluatorProfile"],
  "properties": {
    "id": { "type": "string", "pattern": "^mgds\\.task\\.[a-z0-9.-]+@[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "requiredCapabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^mgds\\.unity\\.[a-z0-9.-]+@[0-9]+\\.[0-9]+\\.[0-9]+$" } },
    "fixtureHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "inputsHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "evaluatorProfile": { "type": "string", "pattern": "^mgds\\.evaluator\\.[a-z0-9.-]+@[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "seed": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
