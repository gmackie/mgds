{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mgds.dev/schemas/v0/harness-outcome.schema.json",
  "title": "MGDS non-authoritative harness outcome",
  "type": "object",
  "required": ["schema", "status", "changedFiles", "commandsRun"],
  "properties": {
    "schema": { "const": "mgds.harness-outcome/v1" },
    "status": { "enum": ["completed", "blocked"] },
    "changedFiles": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "commandsRun": { "type": "integer", "minimum": 0, "maximum": 10000 }
  },
  "additionalProperties": false
}
