{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mgds.dev/schemas/v0/run.schema.json",
  "title": "MGDS run manifest",
  "type": "object",
  "required": ["id", "taskId", "taskHash", "controllerDigest", "adapterDigest", "evaluatorDigest", "policyHash", "unityVersion", "agent", "seed", "startedAt"],
  "properties": {
    "id": { "type": "string", "pattern": "^run_[A-Za-z0-9_-]{16,}$" },
    "taskId": { "type": "string", "pattern": "^mgds\\.task\\.[a-z0-9.-]+@[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "taskHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "controllerDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "adapterDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "evaluatorDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "policyHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "unityVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+[abfp][0-9]+$" },
    "agent": {
      "type": "object",
      "required": ["harness", "model", "budgetHash"],
      "properties": {
        "harness": { "type": "string", "minLength": 1, "maxLength": 120 },
        "model": { "type": "string", "minLength": 1, "maxLength": 120 },
        "budgetHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "seed": { "type": "integer", "minimum": 0 },
    "startedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" }
  },
  "additionalProperties": false
}
