{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mgds.dev/schemas/v0/p3-bundle.schema.json",
  "title": "MGDS P3 portable submission bundle",
  "type": "object",
  "required": ["schema", "manifest", "artifacts", "attestation"],
  "properties": {
    "schema": { "const": "mgds.p3-bundle/v1" },
    "manifest": { "$ref": "https://mgds.dev/schemas/v0/p3-submission.schema.json" },
    "artifacts": { "type": "array", "minItems": 1, "maxItems": 1024, "items": { "type": "object", "required": ["path", "hash", "bytesBase64"], "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 240 }, "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "bytesBase64": { "type": "string" } }, "additionalProperties": false } },
    "attestation": { "type": "object", "required": ["algorithm", "authority", "payloadHash", "signature"], "properties": { "algorithm": { "const": "Ed25519" }, "authority": { "type": "string", "pattern": "^mgds\\.submitter\\.[a-z0-9.-]+@[0-9]+\\.[0-9]+\\.[0-9]+$" }, "payloadHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{40,}$" } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
