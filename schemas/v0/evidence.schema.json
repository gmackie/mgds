{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mgds.dev/schemas/v0/evidence.schema.json",
  "title": "MGDS evidence manifest",
  "type": "object",
  "required": ["runId", "artifacts", "eventsHash", "redactionVersion"],
  "properties": {
    "runId": { "type": "string", "pattern": "^run_[A-Za-z0-9_-]{16,}$" },
    "artifacts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
    "eventsHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "redactionVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
  },
  "additionalProperties": false
}
